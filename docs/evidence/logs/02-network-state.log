
# 설명: 실습용 CIDR과 식별 태그를 가진 VPC를 생성한다.
[2026-08-22T10:24:00Z] $ aws ec2 create-vpc --cidr-block 10.0.0.0/16 --tag-specifications <Project and Name tags>
vpc-0a0a0905f06de4e9d
[exit=0]

# 설명: VPC 내부 DNS 질의 기능을 활성화한다.
[2026-08-22T10:24:01Z] $ aws ec2 modify-vpc-attribute --vpc-id vpc-0a0a0905f06de4e9d --enable-dns-support true

[exit=0]

# 설명: Public IP가 있는 EC2에 DNS 호스트 이름을 부여하도록 설정한다.
[2026-08-22T10:24:02Z] $ aws ec2 modify-vpc-attribute --vpc-id vpc-0a0a0905f06de4e9d --enable-dns-hostnames true

[exit=0]

# 설명: VPC 안에 지정 CIDR과 가용 영역을 사용하는 Public Subnet을 생성한다.
[2026-08-22T10:24:04Z] $ aws ec2 create-subnet --vpc-id vpc-0a0a0905f06de4e9d --cidr-block 10.0.1.0/24 --availability-zone ap-northeast-2a
subnet-01551e5c41451fcbf
[exit=0]

# 설명: Subnet에서 새 EC2에 Public IPv4가 자동 할당되도록 설정한다.
[2026-08-22T10:24:05Z] $ aws ec2 modify-subnet-attribute --subnet-id subnet-01551e5c41451fcbf --map-public-ip-on-launch true

[exit=0]

# 설명: VPC와 인터넷을 연결할 Internet Gateway를 생성한다.
[2026-08-22T10:24:06Z] $ aws ec2 create-internet-gateway --tag-specifications <Project and Name tags>
igw-0e4e625fee863d5b7
[exit=0]

# 설명: 생성한 Internet Gateway를 실습 VPC에 연결한다.
[2026-08-22T10:24:07Z] $ aws ec2 attach-internet-gateway --internet-gateway-id igw-0e4e625fee863d5b7 --vpc-id vpc-0a0a0905f06de4e9d

[exit=0]

# 설명: Public Subnet 전용 Route Table을 생성한다.
[2026-08-22T10:24:09Z] $ aws ec2 create-route-table --vpc-id vpc-0a0a0905f06de4e9d
rtb-0da00fd56d22d1e00
[exit=0]

# 설명: 모든 외부 목적지 트래픽을 Internet Gateway로 보내는 기본 경로를 추가한다.
[2026-08-22T10:24:10Z] $ aws ec2 create-route --route-table-id rtb-0da00fd56d22d1e00 --destination-cidr-block 0.0.0.0/0 --gateway-id igw-0e4e625fee863d5b7
{
    "Return": true
}
[exit=0]

# 설명: Public Subnet이 해당 Route Table을 사용하도록 연결한다.
[2026-08-22T10:24:12Z] $ aws ec2 associate-route-table --route-table-id rtb-0da00fd56d22d1e00 --subnet-id subnet-01551e5c41451fcbf
rtbassoc-07136d8f03fdf3441
[exit=0]

# 설명: VPC의 CIDR, 상태와 Project 태그를 확인한다.
[2026-08-22T10:24:13Z] $ aws ec2 describe-vpcs --vpc-ids vpc-0a0a0905f06de4e9d <limited fields>
[
    {
        "VpcId": "vpc-0a0a0905f06de4e9d",
        "CidrBlock": "10.0.0.0/16",
        "State": "available",
        "Project": "codyssey-06-1"
    }
]
[exit=0]

