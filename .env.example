# Long-term IAM credentials (local .env only; never commit real values)
AWS_BASE_ACCESS_KEY_ID=
AWS_BASE_SECRET_ACCESS_KEY=

# MFA session credentials (replace whenever the session expires)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_MFA_SERIAL=

# AWS CLI settings
AWS_REGION=ap-northeast-2
AWS_DEFAULT_REGION=ap-northeast-2
AWS_DEFAULT_OUTPUT=json

# Lab settings
LAB_PROJECT=codyssey-06-1
LAB_RESOURCE_PREFIX=lab-cloud-web
LAB_AZ=ap-northeast-2a
LAB_VPC_CIDR=10.0.0.0/16
LAB_SUBNET_CIDR=10.0.1.0/24
LAB_LEARNER_IP_CIDR=
LAB_INSTANCE_TYPE=t3.micro
LAB_KEY_NAME=lab-cloud-web-key

# Values populated after resource creation
LAB_AMI_ID=
LAB_VPC_ID=
LAB_SUBNET_ID=
LAB_IGW_ID=
LAB_ROUTE_TABLE_ID=
LAB_ROUTE_ASSOCIATION_ID=
LAB_SECURITY_GROUP_ID=
LAB_INSTANCE_ID=
LAB_VOLUME_ID=
LAB_PUBLIC_IP=
